{
  "version": 1,
  "comment": "Input of tools/particles/codemod.py. Paths are globs relative to src/main/java/com/newuniverse/nusmp ('**' crosses folders, '*' stays in one). The first matching 'themes' rule names the theme of a file.",

  "skip": {
    "comment": "Never touched, whatever the flags: the Time Magic VFX standard, the particle libraries themselves, the mod entry class, the registries of the Rukh types.",
    "globs": [
      "book/TimeBook.java",
      "vfx/client/layer/TimeMagicLayer.java",
      "particle/rukh/**",
      "client/particle/rukh/**",
      "particle/fx/**",
      "client/particle/fx/**",
      "NUSMP.java"
    ]
  },

  "rukh_keep": {
    "comment": "Rukh (the magoi) stays here: Djinn users and the dungeons, as the owner decided. Rukh calls in these paths are never rewritten; vanilla particles in them still are.",
    "globs": [
      "relics/djinn/**",
      "client/relics/djinn/**",
      "relics/Fx.java",
      "labyrinth/**",
      "client/labyrinth/**",
      "dungeon/**",
      "client/dungeon/**"
    ]
  },

  "lanes": {
    "comment": "Files other builders are working in right now. Skipped unless the matching flag is given: --include-relics for 'relics', --include-lanes for 'other'.",
    "relics": [
      "relics/wave/**",
      "client/relics/**",
      "relics/socket/**",
      "relics/order/**",
      "relics/pair/**",
      "relics/forge/**"
    ],
    "other": [
      "labyrinth/mega/rift/**"
    ]
  },

  "themes": [
    ["boss/LuciusSpells.java", "boss.lucius"],
    ["celestial/SpiritKingEntity.java", "boss.celestial"],
    ["celestial/**", "skill.celestial"],
    ["shishou/**", "skill.shishou"],
    ["client/ElsdociaGlitterClient.java", "boss.elsdocia"],
    ["client/avatar/**", "boss.avatar"],
    ["client/playermodel/**", "dungeon.humanoid"],
    ["client/remodel/AbyssalRenderer.java", "boss.abyssal"],
    ["compat/create/**", "dungeon.trap"],
    ["corpse/**", "corpse"],
    ["dungeon/floor/charybdis/**", "boss.charybdis"],
    ["dungeon/floor/goliath/**", "boss.goliath"],
    ["dungeon/**", "dungeon"],
    ["entity/Cotton*", "magic.COTTON"],
    ["entity/GrimoireDaemonEntity.java", "grimoire.daemon"],
    ["entity/ZagredBossEntity.java", "boss.zagred"],
    ["entity/avatar/**", "boss.avatar"],
    ["entity/zogratis/Zenon*", "boss.zenon"],
    ["entity/zogratis/Dante*", "boss.dante"],
    ["entity/zogratis/Vanica*", "boss.vanica"],
    ["entity/zogratis/**", "boss.lucius"],
    ["labyrinth/gate/**", "dungeon.gate"],
    ["labyrinth/vault/**", "dungeon.vault"],
    ["labyrinth/squad/**", "dungeon.squad"],
    ["labyrinth/seal/**", "dungeon.seal"],
    ["labyrinth/trial/**", "dungeon.trial"],
    ["labyrinth/mega/crucible/**", "dungeon.crucible"],
    ["labyrinth/mega/decennial/**", "dungeon.decennial"],
    ["labyrinth/mega/guard/**", "dungeon.guardian"],
    ["labyrinth/mega/lock/**", "dungeon.lock"],
    ["labyrinth/mega/safe/**", "dungeon.safe"],
    ["labyrinth/mega/rift/**", "dungeon.rift"],
    ["labyrinth/**", "dungeon"],
    ["requip/**", "skill.requip"],
    ["soul/PaladinFx.java", "skill.paladin"],
    ["thread/**", "magic.THREAD"],
    ["book/BlackOilArts.java", "magic.BLACK_OIL"],
    ["wizard/**", "wizard"],
    ["song/**", "magic.SONG"],
    ["vfx/client/portal/**", "magic.SPATIAL"],
    ["arena/**", "arena.lucius"],
    ["arc/arena/**", "arena.chronicle"],
    ["item/BroochPinArts.java", "item.brooch"],
    ["item/RotDoomArts.java", "item.rotdoom"],
    ["item/HandOfProvidenceArts.java", "item.providence"],
    ["item/**", "item"],
    ["client/SwordDrawClient.java", "magic.SWORD"],
    ["client/grimoire/**", "skill.grimoire"],
    ["skilltree/**", "skill.tree"],
    ["skill/GodTier.java", "skill.god"],
    ["skill/BlackWingsSkill.java", "skill.blackwings"],
    ["skill/**", "skill"],
    ["book/**", "skill.grimoire"],
    ["core/**", "skill.grimoire"],
    ["blackclover/**", "skill.grimoire"],
    ["relics/order/**", "relic.order"],
    ["relics/pair/**", "relic.pair"],
    ["relics/forge/**", "relic.forge"],
    ["relics/socket/**", "relic.socket"],
    ["re:^relics/wave/Wave(\\d+)", "relic.wave.$1"],
    ["relics/wave/**", "relic.wave"],
    ["client/relics/**", "relic"],
    ["relics/**", "relic"]
  ],
  "default_theme": "world",
  "enum_themes": {"blackclover/MagicType.java": "magic."},

  "particles": {
    "comment": "The vanilla particles the codemod replaces. slot: the theme slot (MOTE signature, ACCENT glyph, SPARK sharp, AMBIENT soft). fixed: always this custom particle whatever the theme (elemental ones: a flame stays a flame). rgb: dye colour for tintable particles (0xRRGGBB). themed: a fixed particle takes the theme colour. Not listed (left as they are, with a reason): BLOCK, ITEM, FALLING_DUST, DUST and every option that carries data.",
    "END_ROD": {"slot": "MOTE"},
    "GLOW": {"slot": "MOTE"},
    "HAPPY_VILLAGER": {"slot": "MOTE", "rgb": "0x6BE86B"},
    "HEART": {"slot": "MOTE", "rgb": "0xFF6FA0"},
    "COMPOSTER": {"slot": "MOTE", "rgb": "0x7FE06F"},
    "FIREWORK": {"slot": "SPARK"},
    "CRIT": {"slot": "SPARK"},
    "ELECTRIC_SPARK": {"slot": "SPARK", "rgb": "0xBFD8FF"},
    "DAMAGE_INDICATOR": {"slot": "SPARK", "rgb": "0xFF4050"},
    "ENCHANT": {"slot": "ACCENT"},
    "PORTAL": {"slot": "ACCENT"},
    "REVERSE_PORTAL": {"slot": "ACCENT"},
    "WITCH": {"slot": "ACCENT"},
    "SOUL": {"slot": "ACCENT", "rgb": "0x7FE8FF"},
    "SCULK_SOUL": {"slot": "ACCENT", "rgb": "0x5FC8B8"},
    "CRIMSON_SPORE": {"slot": "ACCENT", "rgb": "0xC03040"},
    "SQUID_INK": {"slot": "AMBIENT"},
    "POOF": {"slot": "AMBIENT"},
    "CLOUD": {"slot": "AMBIENT"},
    "SMOKE": {"slot": "AMBIENT"},
    "LARGE_SMOKE": {"slot": "AMBIENT"},
    "CAMPFIRE_COSY_SMOKE": {"slot": "AMBIENT"},
    "FLAME": {"fixed": "flame_tongue"},
    "SMALL_FLAME": {"fixed": "flame_tongue"},
    "SOUL_FIRE_FLAME": {"fixed": "flame_soul", "rgb": "0x5FD8FF"},
    "LAVA": {"fixed": "lava_blob"},
    "FALLING_LAVA": {"fixed": "lava_blob"},
    "DRIPPING_LAVA": {"fixed": "lava_blob"},
    "ASH": {"fixed": "ash_flake"},
    "SNOWFLAKE": {"fixed": "snowflake"},
    "BUBBLE": {"fixed": "bubble"},
    "BUBBLE_POP": {"fixed": "bubble"},
    "BUBBLE_COLUMN_UP": {"fixed": "bubble"},
    "CURRENT_DOWN": {"fixed": "droplet"},
    "SPLASH": {"fixed": "droplet"},
    "EXPLOSION": {"fixed": "impact_burst", "themed": true},
    "EXPLOSION_EMITTER": {"fixed": "impact_burst", "themed": true},
    "FLASH": {"fixed": "circle_flash", "themed": true},
    "SWEEP_ATTACK": {"fixed": "slash_streak", "themed": true},
    "SONIC_BOOM": {"fixed": "shock_ring", "themed": true}
  }
}
