{
  "_why": "The lair actions of the Decennial bosses: what the HALL does on its own clock, every N seconds, whatever the boss is doing (the D&D idea of a lair action). Each is a layout (pattern), a harm (effect), a size, a warning time in ticks (never under 16: every blow can be seen coming), a share of the boss's attack damage (never over 0.6, and always capped again by the player's hit cap), and the particle that draws it. There is no food-bar effect and no way to write one: the effect list is closed (docs/labyrinth/decennial_bosses.md). 'zone' is the kind of hazard zone of the hall (BossArenaStructure.zone) the action prefers to strike, so grave hands come out of the graves and sap wells up round the roots. Patterns: AT_PLAYERS (a circle under some of the party), RANDOM_SPOTS (circles at the zones or at random), SPOTS (circles at the zones only), LINE_TO_PLAYER (lines from the boss), RING_PULSE (a ring growing from the boss), ZONE (areas that stay and act each second), PULL (everyone dragged towards the boss), TOPPLE (a pillar of the hall falls).",

  "grave_hands":      {"pattern": "SPOTS", "effect": "ROOT", "count": 4, "radius": 2.2, "telegraph": 36, "share": 0.30, "effect_ticks": 20, "particle": "soul", "zone": "grave", "text": "Hands claw up out of the graves!"},
  "soul_fog":         {"pattern": "ZONE", "effect": "SLOW", "count": 2, "radius": 5.5, "telegraph": 30, "share": 0.06, "duration": 140, "effect_ticks": 40, "particle": "soul_fire_flame", "zone": "fog", "text": "A fog of souls rolls over the floor. Leave it."},
  "bone_spikes":      {"pattern": "LINE_TO_PLAYER", "effect": "KNOCKBACK", "count": 2, "radius": 1.4, "telegraph": 30, "share": 0.40, "particle": "crit", "zone": "bone", "text": "Bone spikes tear up the floor towards you!"},
  "blood_rain":       {"pattern": "ZONE", "effect": "WEAKNESS", "count": 3, "radius": 4.0, "telegraph": 30, "share": 0.07, "duration": 120, "effect_ticks": 60, "particle": "crimson_spore", "zone": "blood", "text": "Blood rains from the roof. Step out of it."},
  "hell_geysers":     {"pattern": "RANDOM_SPOTS", "effect": "IGNITE", "count": 6, "radius": 2.2, "telegraph": 34, "share": 0.35, "effect_ticks": 60, "particle": "flame", "zone": "geyser", "text": "Fire erupts from the floor!"},
  "chain_pull":       {"pattern": "PULL", "effect": "NONE", "count": 1, "radius": 18.0, "telegraph": 30, "share": 0.20, "particle": "crit", "text": "Chains lash out and drag everyone towards the boss!"},
  "shadow_tendrils":  {"pattern": "AT_PLAYERS", "effect": "ROOT", "count": 2, "radius": 2.8, "telegraph": 32, "share": 0.25, "effect_ticks": 30, "particle": "squid_ink", "text": "Shadows coil round your feet!"},
  "pillar_fall":      {"pattern": "TOPPLE", "effect": "KNOCKBACK", "count": 2, "radius": 3.0, "telegraph": 36, "share": 0.50, "particle": "cloud", "zone": "pillar", "text": "A pillar groans and begins to fall. Get clear of its path!"},
  "eye_beams":        {"pattern": "LINE_TO_PLAYER", "effect": "DRAIN", "count": 3, "radius": 0.9, "telegraph": 24, "share": 0.30, "particle": "electric_spark", "text": "Eyes open in the dark and fire!"},
  "plague_cloud":     {"pattern": "ZONE", "effect": "POISON", "count": 2, "radius": 5.0, "telegraph": 30, "share": 0.05, "duration": 160, "effect_ticks": 60, "particle": "happy_villager", "zone": "bog", "text": "A plague cloud rises from the bog."},
  "abyss_maw":        {"pattern": "AT_PLAYERS", "effect": "LAUNCH", "count": 1, "radius": 4.5, "telegraph": 46, "share": 0.55, "particle": "portal", "zone": "rift", "text": "The floor splits open under someone. Run!"},
  "root_burst":       {"pattern": "SPOTS", "effect": "ROOT", "count": 4, "radius": 2.0, "telegraph": 30, "share": 0.28, "effect_ticks": 30, "particle": "squid_ink", "zone": "root", "text": "Roots burst from the ground!"},
  "black_sap":        {"pattern": "ZONE", "effect": "SLOW", "count": 3, "radius": 3.2, "telegraph": 30, "share": 0.07, "duration": 140, "effect_ticks": 60, "particle": "squid_ink", "zone": "sap", "text": "Black sap wells up round the roots. Do not stand in it."},
  "spore_burst":      {"pattern": "RING_PULSE", "effect": "CONFUSE", "count": 1, "radius": 10.0, "telegraph": 30, "share": 0.25, "effect_ticks": 60, "particle": "witch", "zone": "psi", "text": "The spores burst, and the room swims!"},
  "web_snare":        {"pattern": "AT_PLAYERS", "effect": "ROOT", "count": 3, "radius": 2.5, "telegraph": 30, "share": 0.12, "effect_ticks": 40, "particle": "cloud", "zone": "web", "text": "Webs shoot out to snare you!"},
  "mirror_shatter":   {"pattern": "RING_PULSE", "effect": "KNOCKBACK", "count": 1, "radius": 12.0, "telegraph": 30, "share": 0.30, "particle": "electric_spark", "zone": "shard", "text": "The mirrors shatter outward!"},
  "steam_vents":      {"pattern": "SPOTS", "effect": "LAUNCH", "count": 5, "radius": 2.0, "telegraph": 28, "share": 0.30, "particle": "cloud", "zone": "vent", "text": "Steam roars out of the vents!"},
  "frost_nova":       {"pattern": "RING_PULSE", "effect": "FREEZE", "count": 1, "radius": 11.0, "telegraph": 34, "share": 0.30, "effect_ticks": 100, "particle": "snowflake", "zone": "frost", "text": "A killing frost spreads from the boss!"},
  "lava_surge":       {"pattern": "RANDOM_SPOTS", "effect": "IGNITE", "count": 5, "radius": 2.6, "telegraph": 38, "share": 0.38, "effect_ticks": 80, "particle": "flame", "zone": "geyser", "text": "Lava surges up from below!"},
  "void_collapse":    {"pattern": "PULL", "effect": "NONE", "count": 1, "radius": 16.0, "telegraph": 34, "share": 0.25, "particle": "portal", "zone": "void", "text": "The void collapses inward and pulls at you!"},
  "tome_storm":       {"pattern": "RANDOM_SPOTS", "effect": "CONFUSE", "count": 5, "radius": 2.0, "telegraph": 28, "share": 0.28, "effect_ticks": 40, "particle": "enchant", "zone": "tome", "text": "Forbidden pages whirl and cut!"},
  "tide_surge":       {"pattern": "ZONE", "effect": "SLOW", "count": 2, "radius": 5.0, "telegraph": 30, "share": 0.05, "duration": 120, "effect_ticks": 60, "particle": "cloud", "zone": "tide", "text": "A tide pours across the floor."},

  "holy_beams":       {"side": "holy", "pattern": "AT_PLAYERS", "effect": "NONE", "count": 3, "radius": 2.0, "telegraph": 36, "share": 0.35, "particle": "end_rod", "zone": "beam", "text": "Beams of holy light fall! Move!"},
  "radiant_nova":     {"side": "holy", "pattern": "RING_PULSE", "effect": "BLIND", "count": 1, "radius": 12.0, "telegraph": 36, "share": 0.30, "effect_ticks": 30, "particle": "end_rod", "text": "A nova of radiance bursts from the boss!"},
  "falling_stars":    {"pattern": "RANDOM_SPOTS", "effect": "NONE", "count": 5, "radius": 2.5, "telegraph": 34, "share": 0.25, "particle": "end_rod", "zone": "beam", "text": "Stars fall around you. Watch the rings!"},
  "judgment_rings":   {"side": "holy", "pattern": "RING_PULSE", "effect": "KNOCKBACK", "count": 1, "radius": 14.0, "telegraph": 40, "share": 0.35, "particle": "end_rod", "zone": "judgment", "text": "Rings of judgment spread across the floor!"},
  "wind_gusts":       {"side": "holy", "pattern": "RING_PULSE", "effect": "KNOCKBACK", "count": 1, "radius": 13.0, "telegraph": 30, "share": 0.15, "particle": "cloud", "zone": "gust", "text": "A great wind sweeps the hall!"},
  "thorn_bloom":      {"side": "holy", "pattern": "SPOTS", "effect": "ROOT", "count": 3, "radius": 2.2, "telegraph": 30, "share": 0.25, "effect_ticks": 30, "particle": "happy_villager", "zone": "bloom", "text": "Thorns bloom round your feet!"},
  "sunburst":         {"side": "holy", "pattern": "AT_PLAYERS", "effect": "BLIND", "count": 1, "radius": 5.0, "telegraph": 50, "share": 0.50, "effect_ticks": 20, "particle": "flame", "zone": "sun", "text": "The sun gathers over someone. Leave the circle!"},
  "crystal_resonance":{"side": "holy", "pattern": "SPOTS", "effect": "SLOW", "count": 6, "radius": 1.8, "telegraph": 30, "share": 0.30, "effect_ticks": 40, "particle": "enchant", "zone": "shard", "text": "The crystals ring, and shatter!"},
  "moonbeam":         {"side": "holy", "pattern": "AT_PLAYERS", "effect": "WEAKNESS", "count": 2, "radius": 2.4, "telegraph": 34, "share": 0.28, "effect_ticks": 60, "particle": "end_rod", "zone": "moon", "text": "Moonlight falls in pillars!"},
  "storm_bolts":      {"side": "holy", "pattern": "RANDOM_SPOTS", "effect": "NONE", "count": 6, "radius": 1.7, "telegraph": 24, "share": 0.32, "particle": "electric_spark", "zone": "bolt", "text": "Lightning strikes the floor!"}
}
