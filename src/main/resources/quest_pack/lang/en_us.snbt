	"quest.5B66BC36B528DAA1.title": "The Pair of Vecna"
	"quest.5B8A9A1EFAF712A7.quest_desc": [
		"Lucifero is the devil of the third circle."
		""
		"This boss is not in the Multiverse yet. The quest completes by itself on the day the boss is added and defeated."
	]
	"quest.5B8A9A1EFAF712A7.quest_subtitle": "Awaiting the boss"
	"quest.5B8A9A1EFAF712A7.title": "Lucifero"
