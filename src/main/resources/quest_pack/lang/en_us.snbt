	"quest.6255311CC4B1725F.title": "Captain"
	"quest.62BC305F4B28121F.quest_desc": [
		"A raid on the Royal Capital calls every Magic Knight to the walls. This is the arc where a mage's signature spell stops being a page and becomes a name."
	]
	"quest.62BC305F4B28121F.quest_subtitle": "Arc 4"
	"quest.62BC305F4B28121F.title": "Dark Triad: The Royal Capital"
	"quest.639C3B8BA9C544E8.quest_desc": [
		"Cast Thread Magic, the first of this branch. The magics of this branch: Thread, Sealing, Chain, Key, Barrier, Switching, and more."
	]
	"quest.639C3B8BA9C544E8.quest_subtitle": "Everything that binds"
	"quest.639C3B8BA9C544E8.title": "Thread, Seal and Chain: Awaken"
