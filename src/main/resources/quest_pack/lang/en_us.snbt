	"quest.7A4CAE9F1A8A1507.quest_subtitle": "Curses"
	"quest.7A4CAE9F1A8A1507.title": "Vanica"
	"quest.7AF25C11F5E8A189.quest_desc": [
		"You came through the forest with the cat in your arms. That is more than most can say."
	]
	"quest.7AF25C11F5E8A189.quest_subtitle": "Through the thread"
	"quest.7AF25C11F5E8A189.title": "Out of the Forest"
	"quest.7B9382B61AC440DA.quest_desc": [
		"Carry both the Hand and the Eye of Vecna. Worn and attuned together, they are a bonded pair with a set bonus of their own."
	]
	"quest.7B9382B61AC440DA.quest_subtitle": "Hand and Eye"
	"quest.7B9382B61AC440DA.title": "The Pair of Vecna"
	"quest.7C1FABF59CF0A18E.quest_desc": [
		"Once a year the grimoires choose every mage who comes to a Grimoire Tower. If you missed the day, any altar will take you in later."
		""
		"Take part in the ceremony and the book is yours."
	]
	"quest.7C1FABF59CF0A18E.quest_subtitle": "Chosen at the tower"
	"quest.7C1FABF59CF0A18E.title": "The Acceptance Ceremony"
	"quest.7C467B7016AD62E5.quest_desc": [
		"Deep in the forest the witches keep to themselves, and their magic is thread and trap. A cat named Rouge is lost, and a forest full of traps stands between her and her witch."
	]
	"quest.7C467B7016AD62E5.quest_subtitle": "Arc 6"
	"quest.7C467B7016AD62E5.title": "The Witches' Forest"
	"quest.7C8373960FA33049.quest_desc": ["Enter any dungeon of the Multiverse."]
	"quest.7C8373960FA33049.quest_subtitle": "Enter"
	"quest.7C8373960FA33049.title": "Rumours of a Dungeon"
