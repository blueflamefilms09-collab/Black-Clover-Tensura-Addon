	"quest.5BF74C5A389D2DC1.quest_subtitle": "Attune"
	"quest.5BF74C5A389D2DC1.title": "Wear What You Hold"
	"quest.5C655402665E6DC0.quest_desc": [
		"Every magic of the branch cast, and a signature page after it. You are a master of this branch."
	]
	"quest.5C655402665E6DC0.quest_subtitle": "Master of the branch"
	"quest.5C655402665E6DC0.title": "Song, Butoh, Soul and Shadow: Mastery"
	"quest.5CD263E4872BA9BA.quest_desc": [
