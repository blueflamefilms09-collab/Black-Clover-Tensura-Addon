	"quest.04B8C43886493317.quest_subtitle": "Grade 7 of 7"
	"quest.04B8C43886493317.title": "Genesis Grade"
	"quest.04C309EB03AEC576.quest_desc": [
		"Hold a relic of God Grade. The higher the grade, the more it lifts the wearer's existence points."
	]
	"quest.04C309EB03AEC576.quest_subtitle": "Grade 6 of 7"
	"quest.04C309EB03AEC576.title": "God Grade"
	"quest.054034E25FC6DC8F.quest_desc": [
		"Cook monster meat and eat it. The best way to survive is to eat what lives here."
