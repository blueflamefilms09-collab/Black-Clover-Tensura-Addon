	"quest.1B69552CBBEB9513.quest_subtitle": "All 105"
	"quest.1B69552CBBEB9513.title": "Master of Every Magic"
	"quest.1BA26443D9623F20.quest_desc": [
		"The last of the Zogratis siblings has been waiting. He does not need a bloated bar of health: he is a tactician with a hundred spells and a clock of his own. The Hourglass of the Final Hour carries a challenger to his arena."
	]
	"quest.1BA26443D9623F20.quest_subtitle": "Arc 12"
	"quest.1BA26443D9623F20.title": "Spade Kingdom Invasion: The Final Arc"
	"quest.1C0D07DCFCBB6855.quest_desc": ["Defeat any boss of the Multiverse."]
	"quest.1C0D07DCFCBB6855.quest_subtitle": "Any boss"
	"quest.1C0D07DCFCBB6855.title": "First Blood"
	"quest.1C2642D31B6BB8C0.quest_desc": [
		"Receive a grimoire from the Heart Kingdom."
	]
	"quest.1C2642D31B6BB8C0.quest_subtitle": "A grimoire of this suit"
	"quest.1C2642D31B6BB8C0.title": "Heart Kingdom"
