	"quest.64651FE09E0211B2.title": "Direwolf Pack"
	"quest.646FF060A989B7AA.quest_desc": [
		"The exam has an examiner."
		""
		"This boss is not in the Multiverse yet. The quest completes by itself on the day the boss is added and defeated."
	]
	"quest.646FF060A989B7AA.quest_subtitle": "Awaiting the boss"
	"quest.646FF060A989B7AA.title": "The Examiner"
	"quest.6484E94955E79302.quest_desc": [
		"On the day of the ceremony the grimoires choose. Some mages receive a three-leaf, a few a four-leaf, and now and then a mage receives something nobody has seen before."
	]
	"quest.6484E94955E79302.quest_subtitle": "A grimoire of your own"
	"quest.6484E94955E79302.title": "The Grimoire Chooses"
	"quest.65836F3A0D9FEDE2.quest_desc": [
		"You have a grimoire, a first spell and the habit of training. The village is behind you; the capital is ahead."
		""
		"Unlock five pages of your grimoire and take a reward for the road."
	]
	"quest.65836F3A0D9FEDE2.quest_subtitle": "Five open pages"
	"quest.65836F3A0D9FEDE2.title": "Bound by a Grimoire"
	"quest.66D12DC0E20C983B.quest_desc": [
		"Zagred and the avatar are down. The rest are still waiting; the book will tell you when they come."
	]
	"quest.66D12DC0E20C983B.quest_subtitle": "For now"
	"quest.66D12DC0E20C983B.title": "The Devils Quelled"
	"quest.66DBFBB09073A9BF.quest_desc": [
		"The Eye of the Midnight Sun has a leader."
		""
		"This boss is not in the Multiverse yet. The quest completes by itself on the day the boss is added and defeated."
	]
	"quest.66DBFBB09073A9BF.quest_subtitle": "Awaiting the boss"
	"quest.66DBFBB09073A9BF.title": "The Eye of the Midnight Sun"
	"quest.670D9A20D2396885.quest_desc": ["Use a Relic Forge on a relic."]
	"quest.670D9A20D2396885.quest_subtitle": "Work it at the forge"
	"quest.670D9A20D2396885.title": "Reforged"
	"quest.6801A5BA3BC1D657.quest_desc": [
		"Pair relics are two weapons that are one relic: they come together, the world holds one pair, and the bonus works only with a half in each hand. Carry both halves of the Twin Hook Swords."
	]
	"quest.6801A5BA3BC1D657.quest_subtitle": "Right hand and left"
	"quest.6801A5BA3BC1D657.title": "A Matched Pair"
	"quest.6827079BC0B8F1DF.quest_desc": [
		"A devil's avatar walks the world. Defeat it."
	]
	"quest.6827079BC0B8F1DF.quest_subtitle": "A body for a devil"
	"quest.6827079BC0B8F1DF.title": "The Devil's Avatar"
	"quest.6859D66D7BFAE575.quest_desc": [
		"Some mages do not rely on their own magic alone. A Spirit Lord lends its element; a devil lends its power at a price."
		""
		"Both give extra pages for your grimoire. Neither is free: a spirit asks for trust, a devil for a contract read last."
	]
	"quest.6859D66D7BFAE575.quest_subtitle": "Spirit or devil?"
	"quest.6859D66D7BFAE575.title": "Powers That Answer"
	"quest.685ED5C47D5DB75E.quest_desc": [
		"You are holding the quest book now. Chapters on the left are grouped: The Journey teaches the systems of the mod, The Anime Arcs follow the story arc by arc, and Bosses and Challenges is the gauntlet. Rewards are claimed with a click; some are shared with your team."
	]
	"quest.685ED5C47D5DB75E.quest_subtitle": "The quest book"
	"quest.685ED5C47D5DB75E.title": "This Very Book"
	"quest.68E33F8680AA0587.quest_desc": [
		"Enter the Grimoire Library dimension, where the wizards keep their books."
	]
	"quest.68E33F8680AA0587.quest_subtitle": "The library dimension"
	"quest.68E33F8680AA0587.title": "Grimoire Library"
	"quest.694C2E9F6DAB28A3.quest_desc": ["Unite with a devil."]
	"quest.694C2E9F6DAB28A3.quest_subtitle": "Fuse"
	"quest.694C2E9F6DAB28A3.title": "Devil Union"
	"quest.69988337C2074CD0.quest_desc": [
		"Cast each of the 5 magics of this branch once. Not all of them are in the same grimoire: magics can be learned, merged and borrowed over a long career."
	]
	"quest.69988337C2074CD0.quest_subtitle": "5 magics"
	"quest.69988337C2074CD0.title": "Song, Butoh, Soul and Shadow: Every Magic"
	"quest.69ADB434A73CF246.quest_desc": [
		"The selection exam is a team event. Found a squad."
	]
	"quest.69ADB434A73CF246.quest_subtitle": "A squad of three"
	"quest.69ADB434A73CF246.title": "Form a Team"
	"quest.69F17CE19B67B831.quest_desc": [
		"A shadow mage can unite with a beast. Take all four Unite forms."
	]
	"quest.69F17CE19B67B831.quest_subtitle": "Canis, Equus, Felis, Gallus"
	"quest.69F17CE19B67B831.title": "Four Forms of the Shadow"
	"quest.6A269B9D525F9275.quest_desc": [
		"Raise a relic through a tier ritual. A higher tier scales its acts."
	]
