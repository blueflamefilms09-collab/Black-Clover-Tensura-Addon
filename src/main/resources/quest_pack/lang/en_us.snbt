	"quest.6ACB36753E4D140E.title": "Squad Hunt: The Floors"
	"quest.6AE9DB00B892D9EF.quest_desc": [
		"The Spade Kingdom sends its Dark Triad. Three siblings, three kinds of magic, and a bond between them that makes the second fall harder than the first."
	]
