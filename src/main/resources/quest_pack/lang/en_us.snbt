	"quest.045FE7BC2CC14533.quest_subtitle": "A pact"
	"quest.045FE7BC2CC14533.title": "A Spirit Answers"
	"quest.04B8C43886493317.quest_desc": [
		"Hold a relic of Genesis Grade. The highest grade there is. Hold one and the world watches you."
