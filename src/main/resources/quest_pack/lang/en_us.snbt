	"quest.509661F9351D0B73.title": "Water Magic"
	"quest.513DE0C789A51027.quest_desc": ["Kill ten Zogratis clones."]
	"quest.513DE0C789A51027.quest_subtitle": "Zogratis clones"
	"quest.513DE0C789A51027.title": "Echoes"
	"quest.519D28E29EE8273D.quest_desc": [
		"The Royal Knights pick their next members in a tournament of squads and trials. In this world the trial is the Labyrinth: a dungeon with doors that open only to those who earned them."
	]
	"quest.519D28E29EE8273D.quest_subtitle": "Arc 8"
	"quest.519D28E29EE8273D.title": "Royal Knights Selection Exam"
	"quest.51A85AE2CA5B2BDC.quest_desc": [
		"Push Lucius into his third and final stage."
	]
	"quest.51A85AE2CA5B2BDC.quest_subtitle": "The last bar"
	"quest.51A85AE2CA5B2BDC.title": "The Third Stage"
	"quest.51AD1DDE5716D94B.quest_desc": [
		"Meet one of the four elemental Spirit Lords."
	]
	"quest.51AD1DDE5716D94B.quest_subtitle": "Salamander, Undine, Sylph, Gnome"
	"quest.51AD1DDE5716D94B.title": "True Body of an Element"
	"quest.51DEC445711B302B.quest_desc": [
		"The Multiverse knows 105 magics, from the flame of a lion to the word of a devil. They are gathered here in nine branches. Each branch is a chain: awaken the first magic, cast every magic of the branch, cast a signature page, and finally master them all."
		""
		"Start wherever your grimoire points you; the branches can be done in any order."
	]
	"quest.51DEC445711B302B.quest_subtitle": "One hundred and five magics"
	"quest.51DEC445711B302B.title": "The Many Magics"
	"quest.51F164ADA72E54E2.quest_desc": [
		"Cast each of the 11 magics of this branch once. Not all of them are in the same grimoire: magics can be learned, merged and borrowed over a long career."
	]
	"quest.51F164ADA72E54E2.quest_subtitle": "11 magics"
	"quest.51F164ADA72E54E2.title": "Nature and Whimsy: Every Magic"
	"quest.525C1D214745A32C.quest_desc": ["Carry the Spirit Lord skill."]
	"quest.525C1D214745A32C.quest_subtitle": "The skill itself"
	"quest.525C1D214745A32C.title": "Spirit Lord"
	"quest.52B39607661D111F.quest_desc": ["Carry all twelve Djinn seals."]
	"quest.52B39607661D111F.quest_subtitle": "All twelve"
	"quest.52B39607661D111F.title": "Twelve Seals of the Djinn"
	"quest.52D84D4A7EB85132.quest_desc": ["Kill five basilisks of the dungeon."]
	"quest.52D84D4A7EB85132.quest_subtitle": "Five basilisks"
	"quest.52D84D4A7EB85132.title": "Basilisk Hunt"
	"quest.5465D14C08E96C1C.quest_desc": [
		"Feel your soul corrode. It is how a devil's price shows up."
	]
	"quest.5465D14C08E96C1C.quest_subtitle": "The first crack"
	"quest.5465D14C08E96C1C.title": "Soul Corruption"
	"quest.549148E38AD9EAF0.quest_desc": [
		"Defeat the Spawn of Charybdis in its basin."
	]
	"quest.549148E38AD9EAF0.quest_subtitle": "The whirlpool"
	"quest.549148E38AD9EAF0.title": "Spawn of Charybdis"
	"quest.551D10238EAD3753.quest_desc": [
		"Sign a contract with a spirit. It gives you more room in your grimoire: four extra open pages."
	]
	"quest.551D10238EAD3753.quest_subtitle": "Sign with a spirit"
	"quest.551D10238EAD3753.title": "A Spirit Answers"
	"quest.55236ED9287EFE1E.quest_desc": [
		"Every magic of the branch cast, and a signature page after it. You are a master of this branch."
	]
	"quest.55236ED9287EFE1E.quest_subtitle": "Master of the branch"
	"quest.55236ED9287EFE1E.title": "Elements: Mastery"
	"quest.55BFA770A1B1265C.quest_desc": [
		"The Eye of the Midnight Sun hunts relics from the oldest age. To match them you will need relics of your own, and the forge to work them."
	]
	"quest.55BFA770A1B1265C.quest_subtitle": "Arc 5"
	"quest.55BFA770A1B1265C.title": "Eye of the Midnight Sun"
	"quest.55CD84DDD1BBB2C3.quest_desc": [
		"Open a seal of the Labyrinth with the key."
	]
	"quest.55CD84DDD1BBB2C3.quest_subtitle": "Turn the key"
	"quest.55CD84DDD1BBB2C3.title": "A Seal Opens"
	"quest.56A8F22FA16AB384.quest_desc": [
		"Lucius Zogratis can be fought only in his own arena, and only through the Hourglass of the Final Hour."
		""
		"The fight has three stages with one health bar each; a hard cap on how much a single hit can take; true damage as a percent of your health; and a clock of decay. It is balanced for two to four players. Nothing here is an exam you can cheese."
	]
	"quest.56A8F22FA16AB384.quest_subtitle": "Lucius, balanced"
	"quest.56A8F22FA16AB384.title": "The Final Hour"
	"quest.56DE10B04B023FDB.quest_desc": ["Strike with the Genesis Demon-Slayer."]
	"quest.56DE10B04B023FDB.quest_subtitle": "Awaken the Genesis power"
	"quest.56DE10B04B023FDB.title": "Genesis Edge"
	"quest.56FC524EBCF5D391.quest_desc": [
		"Carry the mana-forged sword, spear and bow."
	]
	"quest.56FC524EBCF5D391.quest_subtitle": "Sword, spear and bow"
	"quest.56FC524EBCF5D391.title": "Forged of Mana"
	"quest.5835165BDE8B2F7E.quest_desc": [
		"Receive a grimoire from the Diamond Kingdom."
	]
	"quest.5835165BDE8B2F7E.quest_subtitle": "The Diamond suit"
	"quest.5835165BDE8B2F7E.title": "A Grimoire of Diamonds"
	"quest.5852988D049E7C01.quest_desc": [
		"A signature page is the spell a mage is known for. Unlock and cast one of this branch's signature pages."
	]
	"quest.5852988D049E7C01.quest_subtitle": "A spell to be known by"
	"quest.5852988D049E7C01.title": "Space, Time and Gravity: Signature"
	"quest.586ACC8AF2FA388B.quest_desc": [
		"Dante, Vanica and Zenon in one night. Any member can land any of the kills; the squad needs all three."
	]
	"quest.586ACC8AF2FA388B.quest_subtitle": "Three siblings, three members"
	"quest.586ACC8AF2FA388B.title": "Squad Hunt: The Triad"
	"quest.588E341951F92AD5.quest_desc": [
		"Every boss of the Multiverse is on this ladder, in rough order of difficulty. Boss kills count for the whole team: a squad that hunts together shares the credit, and this book is shared by the team too."
		""
		"The ladder has four tiers: the floor bosses, the Dark Triad and their friends, the devils and the God of Order, and the last Zogratis."
	]
	"quest.588E341951F92AD5.quest_subtitle": "A ladder of fights"
	"quest.588E341951F92AD5.title": "The Gauntlet"
	"quest.5892D072964202A8.quest_desc": [
		"Receive a grimoire from the Spade Kingdom."
	]
	"quest.5892D072964202A8.quest_subtitle": "The Spade suit"
	"quest.5892D072964202A8.title": "A Grimoire of Spades"
	"quest.58A90EBAA105FDC0.quest_desc": [
		"Hold a relic of Unique Grade. The higher the grade, the more it lifts the wearer's existence points."
	]
	"quest.58A90EBAA105FDC0.quest_subtitle": "Grade 4 of 7"
	"quest.58A90EBAA105FDC0.title": "Unique Grade"
	"quest.59FAD28D06C4F72E.quest_desc": [
		"A signature page is the spell a mage is known for. Unlock and cast one of this branch's signature pages."
	]
	"quest.59FAD28D06C4F72E.quest_subtitle": "A spell to be known by"
	"quest.59FAD28D06C4F72E.title": "Body, Blood and Bone: Signature"
	"quest.5A318125F3C5B252.quest_desc": [
		"A relic is a treasure from another world. There is only one of each in the entire server, written in the Unique Ledger of the God of Order."
		""
		"They cannot be crafted and they do not drop from ordinary monsters: you will find them in dungeon vaults, in the Labyrinth's vault at the top, and as rare rewards from the oldest bosses."
	]
	"quest.5A318125F3C5B252.quest_subtitle": "Each one exists once"
	"quest.5A318125F3C5B252.title": "Relics of Many Worlds"
	"quest.5A4EF464A1BA6A60.quest_desc": [
		"A signature page is the spell a mage is known for. Unlock and cast one of this branch's signature pages."
	]
	"quest.5A4EF464A1BA6A60.quest_subtitle": "A spell to be known by"
	"quest.5A4EF464A1BA6A60.title": "Light and Dark: Signature"
	"quest.5A6CFCE0D9770B2B.quest_desc": [
		"Beneath the Multiverse live the devils. They bargain, they rule, and when one is called into the world it is rarely alone."
	]
	"quest.5A6CFCE0D9770B2B.quest_subtitle": "Arc 13"
	"quest.5A6CFCE0D9770B2B.title": "The Devil Arc"
	"quest.5AE5A46F058E1140.quest_desc": [
		"Cast each of the 10 magics of this branch once. Not all of them are in the same grimoire: magics can be learned, merged and borrowed over a long career."
	]
	"quest.5AE5A46F058E1140.quest_subtitle": "10 magics"
	"quest.5AE5A46F058E1140.title": "Body, Blood and Bone: Every Magic"
