	"quest.03CAED70D2019BE8.quest_subtitle": "The word that kills"
	"quest.03CAED70D2019BE8.title": "Zagred, Devil of the Word"
	"quest.042C15F19B71CECB.quest_desc": ["Carry a Shadow Key."]
