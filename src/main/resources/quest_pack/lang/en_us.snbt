	"quest.603A695A183F74E7.quest_subtitle": "Read the last line"
	"quest.603A695A183F74E7.title": "A Devil's Contract"
	"quest.60B9E3B01920EB72.quest_desc": ["Enter the arena."]
	"quest.60B9E3B01920EB72.quest_subtitle": "Step into the arena"
	"quest.60B9E3B01920EB72.title": "The Final Hour"
	"quest.613F9A5B5445A93C.quest_desc": ["Merge two magics into one spell."]
	"quest.613F9A5B5445A93C.quest_subtitle": "First merger"
	"quest.613F9A5B5445A93C.title": "Two Magics, One Spell"
	"quest.6140DF5E887349DB.quest_desc": [
		"Push Lucius into his third and final stage."
	]
	"quest.6140DF5E887349DB.quest_subtitle": "Two bars down"
	"quest.6140DF5E887349DB.title": "The Third Stage"
