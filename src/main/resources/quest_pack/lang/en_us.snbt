	"file.0000000000000001.title": "Multiverse of Anime"
	"quest.00684DF180DA7D43.quest_desc": [
		"The examiners watch your casting. Fifty spells, accurately aimed."
	]
	"quest.00684DF180DA7D43.quest_subtitle": "Fifty casts"
	"quest.00684DF180DA7D43.title": "The Practical Exam"
	"quest.00AC19767ED79348.quest_desc": [
		"The Four Kingdoms menu shows which kingdom accepted you and what each kingdom stands for. Take a look."
	]
	"quest.00AC19767ED79348.quest_subtitle": "Clover, Spade, Heart, Diamond"
	"quest.00AC19767ED79348.title": "Four Kingdoms"
	"quest.01B51312B0858292.quest_desc": [
		"Carry all nine devil cores at once. Choose what to do with a devil's whole choir."
	]
	"quest.01B51312B0858292.quest_subtitle": "The whole set"
	"quest.01B51312B0858292.title": "Nine Devil Cores"
	"quest.020B70DE7A998001.quest_desc": [
		"Hold a relic of Special Grade. The higher the grade, the more it lifts the wearer's existence points."
	]
	"quest.020B70DE7A998001.quest_subtitle": "Grade 2 of 7"
	"quest.020B70DE7A998001.title": "Special Grade"
	"quest.0214DA5A23791502.quest_desc": [
		"Carry all twelve Djinn seals: Amon, Baal, Bifron, Focalor, Furfur, Marchosias, Paimon, Sitri, Vassago, Vinea, Zagan, Zepar."
	]
	"quest.0214DA5A23791502.quest_subtitle": "All twelve"
	"quest.0214DA5A23791502.title": "Twelve Seals of the Djinn"
	"quest.02A18319D8526753.quest_desc": [
		"Every soul has a nature: Flame, Water, Wind, Earth, Light, Darkness, Space, Time, Battle, Fantasy, or Empty. Cast at least one magic of each soul to see how far your own nature reaches."
	]
	"quest.02A18319D8526753.quest_subtitle": "Eleven soul types"
	"quest.02A18319D8526753.title": "Know Your Soul"
	"quest.02A3EF952ECC1EC5.quest_desc": [
		"Receive a grimoire from the Clover Kingdom."
	]
	"quest.02A3EF952ECC1EC5.quest_subtitle": "A grimoire of this suit"
	"quest.02A3EF952ECC1EC5.title": "Clover Kingdom"
	"quest.02B8976CEF3700F2.quest_desc": [
		"Carry a devil contract. The price is always on the last line."
	]
	"quest.02B8976CEF3700F2.quest_subtitle": "Read the last line first"
	"quest.02B8976CEF3700F2.title": "A Devil's Contract"
	"quest.03736C8E2E0232A3.quest_desc": [
		"Studying happens in the Grimoire Library dimension, where the wizards keep their books. Go there and read."
