	"quest.1C4F8762F1DD088A.title": "A Small Hoard"
	"quest.1CC9FE61B2584BAA.quest_desc": [
		"Every spell costs mana and mana refills slowly. Cast twenty-five times to learn the rhythm of spending and recovering."
