	"quest.63E175378A296ED8.title": "The Hourglass"
	"quest.63E4656EBDF885BE.quest_desc": [
		"Dante, Vanica and Zenon are down. Their bond is broken."
		""
		"Bosses give rare relics: look for the Gravity Crown and the Spatial Ring."
	]
	"quest.63E4656EBDF885BE.quest_subtitle": "All three"
	"quest.63E4656EBDF885BE.title": "The Dark Triad Falls"
