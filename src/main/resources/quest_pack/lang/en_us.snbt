	"quest.1FBCB34D91276B23.title": "Compat Codex"
	"quest.1FEC04F611BA9AD7.quest_desc": [
		"Dance a Butoh, sing a song, raise a corpse, convert a paladin, save Rouge, spring a thread trap, travel through shadows, stop time. Do any one of them."
