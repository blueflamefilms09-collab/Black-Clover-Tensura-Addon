	"quest.07924558FC4280E7.quest_subtitle": "Socket a core"
	"quest.07924558FC4280E7.title": "Set the Core"
	"quest.0912E0796CC27B5F.quest_desc": [
		"Every boss the Multiverse has, defeated. The gauntlet is closed."
