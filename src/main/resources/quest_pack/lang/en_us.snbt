	"quest.1D32A8FFE0642A87.title": "Otherworld Trident"
	"quest.1ED5D47CE7D47F1F.quest_desc": [
		"At the edge of the Clover Kingdom lies a village called Hage, and in it two orphans who made a promise: to become Wizard King. One has no magic at all. The other has more than anyone his age."
		""
		"This arc is the day the grimoires choose."
	]
	"quest.1ED5D47CE7D47F1F.quest_subtitle": "Arc 1"
	"quest.1ED5D47CE7D47F1F.title": "Hage Village"
	"quest.1F16959786941523.quest_desc": [
		"All six Infinity Stones and the Gauntlet, carried at once. Choose carefully what you do with the power."
	]
	"quest.1F16959786941523.quest_subtitle": "Snap"
	"quest.1F16959786941523.title": "All Six Stones"
	"quest.1F321E9DCBCF3324.quest_desc": [
		"Some mages learn to merge two magics into a single spell. It costs more, hits harder, and is the road to the rarest abilities."
	]
	"quest.1F321E9DCBCF3324.quest_subtitle": "Magic merging"
	"quest.1F321E9DCBCF3324.title": "Two Magics, One Spell"
	"quest.1F4428D635FC1DB1.quest_desc": [
		"Magic is not something you are taught here. It is something that chooses you."
		""
		"This book follows you from your first grimoire to the last boss of the Multiverse. Every quest is tied to an advancement, so what you do in the world is what you tick off here. Nothing is lost if you skip ahead: quests unlock in a gentle order, and the paths are yours to take."
	]
	"quest.1F4428D635FC1DB1.quest_subtitle": "Where every world is a page"
	"quest.1F4428D635FC1DB1.title": "Welcome to the Multiverse"
	"quest.1F921EB3DE0F6525.quest_desc": [
		"Win in the arena. Take a reward: you have earned it."
	]
	"quest.1F921EB3DE0F6525.quest_subtitle": "Win in the arena"
	"quest.1F921EB3DE0F6525.title": "Hour's End"
