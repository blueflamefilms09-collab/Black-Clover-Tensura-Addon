	"quest.6A2E4C72DEF47C92.title": "Hold a Relic"
	"quest.6AAEBE5FA6E05BBD.quest_desc": [
		"A grimoire from each of the four kingdoms. Rare, and a little suspicious."
	]
	"quest.6AAEBE5FA6E05BBD.quest_subtitle": "One of each"
	"quest.6AAEBE5FA6E05BBD.title": "Citizen of All Four"
	"quest.6ACB36753E4D140E.quest_desc": [
		"One member takes Goliath, another the Charybdis spawn, a third a Warden. Quest progress belongs to the whole FTB team, so the quest completes when each of the three has fallen to anyone in the squad."
	]
