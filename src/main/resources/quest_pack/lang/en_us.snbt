	"quest.6CBBFDF3BB5C7E5A.title": "Nullified"
	"quest.6CBF38CF531CDD43.quest_desc": ["Defeat twenty-five bosses in total."]
	"quest.6CBF38CF531CDD43.quest_subtitle": "Twenty-five bosses"
	"quest.6CBF38CF531CDD43.title": "Calamity"
	"quest.6CCEF6EE6B61EC2B.quest_desc": ["Defeat the Devil Avatar."]
	"quest.6CCEF6EE6B61EC2B.quest_subtitle": "A devil in a body"
	"quest.6CCEF6EE6B61EC2B.title": "The Devil's Avatar"
	"quest.6CFD6CDA7A1E9D75.quest_desc": [
		"Every trial answered. There is nothing left to prove; there is only the next server."
	]
	"quest.6CFD6CDA7A1E9D75.quest_subtitle": "Everything"
	"quest.6CFD6CDA7A1E9D75.title": "Legend of the Multiverse"
	"quest.6E6503855FC03E30.quest_desc": ["Push Lucius into his second stage."]
	"quest.6E6503855FC03E30.quest_subtitle": "Three stages, one bar each"
	"quest.6E6503855FC03E30.title": "The Second Stage"
	"quest.6ED19EF9A4775198.quest_desc": [
		"Open the book and cast. The first spell is never the strongest. It is the one you remember."
	]
	"quest.6ED19EF9A4775198.quest_subtitle": "Cast"
	"quest.6ED19EF9A4775198.title": "Your First Spell"
	"quest.6ED5F666577E6219.quest_desc": [
		"Carry the Spirit Lord skill and keep your word."
	]
	"quest.6ED5F666577E6219.quest_subtitle": "Spirit Lord"
	"quest.6ED5F666577E6219.title": "Pacts Kept"
	"quest.6FE45CBADABB0F3F.quest_desc": ["Enter the Dream dimension."]
	"quest.6FE45CBADABB0F3F.quest_subtitle": "Dream Magic's place"
	"quest.6FE45CBADABB0F3F.title": "The Dream World"
	"quest.7017E2B5B5F5F327.quest_desc": [
		"Beside the relics there are named blades: the Demon-Slayer of the Genesis grade, the wizard-king's Elsdocia, the Rimeheart Runeblade, the Otherworld Trident. Each carries Tensura engravings that fit its lore."
	]
	"quest.7017E2B5B5F5F327.quest_subtitle": "Named weapons"
	"quest.7017E2B5B5F5F327.title": "Arms of Many Worlds"
	"quest.7061FBDC6B83D7AF.quest_desc": [
		"Cast Reinforcement Magic, the first of this branch. The magics of this branch: Reinforcement, Body, Blood, Bone, Beast, Scale, and more."
	]
	"quest.7061FBDC6B83D7AF.quest_subtitle": "The flesh made a weapon"
	"quest.7061FBDC6B83D7AF.title": "Body, Blood and Bone: Awaken"
	"quest.71A889358E42AD6B.quest_desc": [
		"Carry a Relic Forge. It engraves, reforges and sockets relics."
	]
	"quest.71A889358E42AD6B.quest_subtitle": "Where relics are worked"
	"quest.71A889358E42AD6B.title": "The Relic Forge"
	"quest.71E252E88C82E596.quest_desc": [
		"Carry the Infinity Gauntlet. Every stone you carry is set in it and answers to its power."
	]
	"quest.71E252E88C82E596.quest_subtitle": "A fist of stones"
	"quest.71E252E88C82E596.title": "The Infinity Gauntlet"
	"quest.71FBCFD3843F9EC2.quest_desc": [
		"The elf's story ends in a fight."
		""
		"This boss is not in the Multiverse yet. The quest completes by itself on the day the boss is added and defeated."
	]
	"quest.71FBCFD3843F9EC2.quest_subtitle": "Awaiting the boss"
	"quest.71FBCFD3843F9EC2.title": "The Reincarnated Elf"
	"quest.7255FC8CE48C2825.quest_desc": [
		"Monster meat is poison raw. Purify it, cook it, and eat. The dungeon feeds those who cook."
	]
	"quest.7255FC8CE48C2825.quest_subtitle": "Cook what you kill"
	"quest.7255FC8CE48C2825.title": "Delicious in Dungeon"
	"quest.72A505BA5C9449EF.quest_desc": [
		"Fifty casts. This is where mastery really starts to move."
	]
	"quest.72A505BA5C9449EF.quest_subtitle": "Fifty casts"
	"quest.72A505BA5C9449EF.title": "Practice Makes Perfect"
	"quest.732CC8D0A6DA0143.quest_desc": [
		"A sealed archway opens only when its trial is done. Carry one."
	]
	"quest.732CC8D0A6DA0143.quest_subtitle": "Trial doors"
	"quest.732CC8D0A6DA0143.title": "Sealed Archway"
	"quest.7399E9D16526E75A.quest_desc": [
		"These quests are all optional and mostly long. They ask for the whole of the Multiverse: every magic, every boss, every stone. The rewards are big, and most of them are shared with your team."
	]
	"quest.7399E9D16526E75A.quest_subtitle": "Harder deeds"
	"quest.7399E9D16526E75A.title": "Trials of the Multiverse"
	"quest.75D818B73512EBFF.quest_desc": [
		"Found a squad: the capital is defended by squads."
	]
	"quest.75D818B73512EBFF.quest_subtitle": "Squads defend"
	"quest.75D818B73512EBFF.title": "Hold the Wall Together"
	"quest.7759C4656DC4E74F.quest_desc": [
		"A relic of Unique grade. The Eye of the Midnight Sun would pay a kingdom for it."
	]
	"quest.7759C4656DC4E74F.quest_subtitle": "Unique grade"
	"quest.7759C4656DC4E74F.title": "Relic Hunter"
	"quest.77BD7BB5A3D37693.quest_desc": [
		"A Magic Knight squad is one FTB Teams party flagged as a squad. The captain is the team owner, the vice-captain is chosen by the captain, everyone else is a member. Quest progress in this book is shared across the team: when anyone completes a quest task, the whole squad has it."
		""
		"Squads also keep a star score and show up on the standings."
	]
	"quest.77BD7BB5A3D37693.quest_subtitle": "Squads are FTB Teams"
	"quest.77BD7BB5A3D37693.title": "Magic Knights Do Not Fight Alone"
	"quest.77CB18B021E27F38.quest_desc": [
		"Carry the fire, water, wind and earth spirit cores."
	]
	"quest.77CB18B021E27F38.quest_subtitle": "Fire, water, wind, earth"
	"quest.77CB18B021E27F38.title": "Four Spirit Cores"
	"quest.7999E3F291A4D5AD.quest_desc": ["Defeat Lucius Zogratis."]
	"quest.7999E3F291A4D5AD.quest_subtitle": "The last Zogratis"
	"quest.7999E3F291A4D5AD.title": "Lucius Falls"
	"quest.79E0BD592400F38E.quest_desc": [
		"Astaroth is the devil of the second."
		""
		"This boss is not in the Multiverse yet. The quest completes by itself on the day the boss is added and defeated."
	]
	"quest.79E0BD592400F38E.quest_subtitle": "Awaiting the boss"
	"quest.79E0BD592400F38E.title": "Astaroth"
